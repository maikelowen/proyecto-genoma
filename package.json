{
  "name": "proyecto-genoma",
  "version": "0.0.0",
  "private": true,
  "description": "Proyecto Genoma: núcleo determinista, simuladores y cliente del juego de criaturas.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"sim/**/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p client",
    "check": "npm run typecheck && npm test",
    "sim": "node sim/genetics/cli.ts",
    "sim:combat": "node sim/combat/cli.ts",
    "sim:profundidad": "node sim/depth/cli.ts",
    "sim:variantes": "node sim/variants/cli.ts",
    "sim:v04": "node sim/v04/cli.ts",
    "build:combate": "node client/build-combate.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
